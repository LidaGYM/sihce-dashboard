# Ruta del archivo SQLite local (usado como cache al cargar Excel y para guardar configuracion)
SQLITE_PATH=./data/app.sqlite

# --- Conexion a SQL Server (opcional, solo si vas a usar la fuente "sqlserver") ---
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=BD_SIHCE
MSSQL_USER=sa
MSSQL_PASSWORD=changeme
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=true

# Tiempo maximo por consulta en milisegundos (la vista puede tardar)
MSSQL_REQUEST_TIMEOUT_MS=120000

# Tabla o vista que expone las columnas del modelo (ver sql/create_view_example.sql)
MSSQL_TABLE=dbo.vw_sihce_modulos_ipress
